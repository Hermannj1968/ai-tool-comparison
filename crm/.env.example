# Kopiér til .env og udfyld. .env må ALDRIG lægges i git.

# Domænet systemet skal køre på (DNS A-record skal pege på serveren)
CRM_DOMAIN=crm.eksempel.dk

# Nøgle til Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Første administrator (oprettes kun hvis databasen er tom)
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Valgfrit
# CRM_MODEL=claude-opus-5-5
# CRM_EFFORT=medium          # low | medium | high – lavere er hurtigere og billigere
# COOKIE_SECURE=false        # kun ved lokal test uden HTTPS
